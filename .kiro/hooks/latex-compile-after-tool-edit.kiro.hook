{
  "enabled": true,
  "name": "Auto-compile LaTeX after edits",
  "description": "Automatically compiles the thesis when .tex or .bib files are modified (by tools or manual saves), then sends a notification",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "pwsh -ExecutionPolicy Bypass -Command \"$result = & '.\\scripts\\compile.ps1'; $exitCode = $LASTEXITCODE; if ($exitCode -eq 0) { & '.\\scripts\\notify-compile-complete.ps1' -Status 'Success' } else { & '.\\scripts\\notify-compile-complete.ps1' -Status 'Failed' }; exit $exitCode\"",
    "timeout": 300
  }
}